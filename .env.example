# Delphi Agent Arena - environment variables (copy to .env and fill in live mode)

# Mainnet Delphi API key (create at https://api-access.delphi.fyi).
# If unset, the agent runs in MOCK mode with fixture data.
DELPHI_API_ACCESS_KEY=

# Firecrawl API key for scraping local-language primary sources (mock skips it).
FIRECRAWL_API_KEY=

# Wallet the API key was issued to (shown on the API keys page). Used ONLY to
# fill feedback draft bodies - feedback.delphi.fyi ties entries to this wallet.
# No private key ever goes in this repo.
DELPHI_WALLET=

# X-Agent-* headers sent with every API call.
X_AGENT_ID=agent-arena
X_AGENT_HARNESS=mistral-vibe
X_AGENT_MODEL=

# Triple-guard for real submissions; without this (plus --live-submit and
# --mode=live) submitDraft() refuses to POST anything.
LIVE_SUBMIT=

# Optional endpoint overrides.
# DELPHI_BASE_URL=https://delphi.fyi/v1
# DELPHI_MARKETS_URL=https://competition.delphi.fyi/markets.json
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1
